{
  "name": "bunyan-furnished-desktop",
  "version": "1.0.0",
  "description": "Bunyan Furnished desktop app",
  "main": "main.js",
  "author": "Bunyan",
  "license": "UNLICENSED",
  "private": true,
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis --x64 --publish never" },
  "devDependencies": { "electron": "31.7.7", "electron-builder": "24.13.3" },
  "build": {
    "appId": "com.bunyan.furnished.desktop",
    "productName": "Bunyan Furnished",
    "files": ["main.js", "offline.html", "icon.png"],
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "artifactName": "Bunyan-Furnished-Setup.${ext}" }
  }
}
