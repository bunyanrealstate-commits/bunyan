<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_kicker" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="📖 بتقرأ دلوقتي" android:textColor="#F0A04B" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔥 0" android:textColor="#F0A04B" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="مكتبتي" android:textColor="#1D2733" android:textSize="17sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="4dp" />
    <ProgressBar android:id="@+id/w_prog" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp"
        android:max="100" android:progress="0" android:layout_marginTop="8dp" android:progressTint="#1F7A55" android:progressBackgroundTint="#F1EADB" />
    <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#7A6A55" android:textSize="12sp" android:layout_marginTop="6dp" />
    <TextView android:id="@+id/w_btn" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="📖 كمّل القراية" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:gravity="center"
        android:background="@drawable/widget_btn" android:padding="9dp" android:layout_marginTop="8dp" />
</LinearLayout>
